NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_DIRECT_URL=
SUPABASE_DB_SESSION_URL=
SUPABASE_DB_TRANSACTION_URL=

# --- Resend (transactional email) -------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
# Create the key in Resend for the verified bimedhealthcare.com domain.
RESEND_API_KEY=
# Sender identity. A bare address is wrapped as "Bimed Healthcare <address>".
RESEND_FROM_EMAIL=noreply@bimedhealthcare.com

# --- Recruitment notification routing ---------------------------------------
# Automated internal notifications are monitored only through the client inbox below.
# The recruitment and overseas addresses remain available for normal correspondence and
# supporting-document replies, but the portal does not send automated internal alerts to them.
BIMED_LOCAL_RECRUITMENT_EMAIL=recruitment@bimedhealthcare.com
BIMED_OVERSEAS_RECRUITMENT_EMAIL=overseas@bimedhealthcare.com
BIMED_MANAGER_EMAIL=manager@bimedhealthcare.com
BIMED_ADMIN_EMAIL=info@bimedhealthcare.com

# --- Admin accounts ---------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Bimed Administrator
ADMIN_SESSION_SECRET=

# --- Staff portal authentication --------------------------------------------
# Server-only. Separate from the admin session signing secret.
# Use a long randomly generated value and store it only in the production secret store.
STAFF_SESSION_SECRET=

# Used to build candidate links and admin password-reset links.
NEXT_PUBLIC_APP_URL=https://recruitment.bimedhealthcare.com
